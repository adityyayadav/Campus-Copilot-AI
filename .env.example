# ---------- LLM: Groq (primary, free tier) ----------
GROQ_API_KEY=
MAIN_MODEL=openai/gpt-oss-120b        # SQL generation + answer synthesis
ROUTER_MODEL=openai/gpt-oss-20b       # routing, HyDE, small talk
FALLBACK_MODEL=openai/gpt-oss-20b
GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# ---------- LLM: Gemini (automatic fallback when Groq is rate limited; same key as embeddings) ----------
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# ---------- Embeddings (hosted API): gemini | cohere | jina ----------
EMBED_PROVIDER=gemini
GOOGLE_API_KEY=                       # https://aistudio.google.com/apikey
COHERE_API_KEY=                       # https://dashboard.cohere.com/api-keys
JINA_API_KEY=

# ---------- Reranker (hosted API): cohere | jina | none ----------
RERANK_PROVIDER=cohere

# ---------- PostgreSQL + pgvector (one database) ----------
DATABASE_URL=postgresql://copilot_admin:copilot_admin_pw@localhost:5433/campus
READER_USER=copilot_reader
READER_PASSWORD=reader_pw_change_me

# ---------- Tuning (optional) ----------
# ROUTER_FAST_CONFIDENCE=0.75
# ROUTER_LLM_MIN_CONFIDENCE=0.55
# CACHE_SIMILARITY=0.95
# INJECTION_THRESHOLD=0.80
# RATE_LIMIT_PER_MIN=20
# DB_POOL_MAX=10
# MAX_CONCURRENT_CHATS=8
# MAX_QUEUED_CHATS=32
