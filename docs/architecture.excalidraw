   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1. embed question (Gemini)\n2. pgvector cosine (dense)\n3. BM25 in SQL (keywords)\n4. RRF fusion\n5. Cohere rerank + threshold\n6. topic filter (relaxed if weak)\n7. small-to-big section expand",
   "originalText": "1. embed question (Gemini)\n2. pgvector cosine (dense)\n3. BM25 in SQL (keywords)\n4. RRF fusion\n5. Cohere rerank + threshold\n6. topic filter (relaxed if weak)\n7. small-to-big section expand",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
